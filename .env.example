# 복사해서 사용: cp .env.example .env
# .env 는 커밋하지 않는다.

# --- Postgres ---
POSTGRES_DB=crashlab
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# 서비스별 DB 계정 비밀번호 (계정은 infra/postgres/init.sql 에서 생성)
MCP_DB_PASSWORD=mcp
HARNESS_DB_PASSWORD=harness
ORACLE_DB_PASSWORD=oracle

# --- LLM ---
LLM_API_KEY=
# 실제 실행 전에 모델을 명시한다. 자료 생성에는 필요하지 않다.
LLM_MODEL=

# --- 호스트 포트 (충돌 시 변경) ---
POSTGRES_PORT=5432
MCP_SERVER_PORT=8081
AGENTS_PORT=8090
HARNESS_PORT=8000
FRONTEND_PORT=5173

# --- 서비스 간 내부 API ---
# mcp-server · harness · agents가 공유하는 X-Internal-Token 값 (LLM 키 아님). 로컬에서 임의 값으로 설정한다.
# 비어 있으면 각 서비스의 내부 API가 거부된다.
INTERNAL_API_TOKEN=

# Harness 개발용 인증 우회. true면 Spring 게이트웨이 헤더 없이 requester-01로 처리 (배포에서는 false)
HARNESS_DEV_AUTH=false

# seed 사용자(requester-01, approver-01) 공통 로그인 비밀번호 (개발용)
DEMO_USER_PASSWORD=crashlab
