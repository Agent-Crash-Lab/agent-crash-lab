# 복사해서 사용: cp .env.example .env
# .env 는 커밋하지 않는다.

# --- Postgres ---
POSTGRES_DB=crashlab
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# 서비스별 DB 계정 비밀번호 (계정은 infra/postgres/init.sql 에서 생성)
MCP_DB_PASSWORD=mcp
HARNESS_DB_PASSWORD=harness
ORACLE_DB_PASSWORD=oracle

# --- LLM ---
LLM_API_KEY=

# --- 호스트 포트 (충돌 시 변경) ---
POSTGRES_PORT=5432
MCP_SERVER_PORT=8081
AGENTS_PORT=8090
HARNESS_PORT=8000
FRONTEND_PORT=5173
