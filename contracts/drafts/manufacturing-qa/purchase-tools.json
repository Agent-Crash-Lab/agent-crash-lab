{
  "contract_version": "0.1.0-dev",
  "status": "DEVELOPMENT_PROPOSAL_NOT_IMPLEMENTED_MCP",
  "context_binding": "run_id·호출자·권한은 실행 어댑터와 서버의 인증된 컨텍스트에서 바인딩. 모델 인자를 권한으로 신뢰하지 않는다.",
  "tools": [
    {
      "name": "get_inventory",
      "effect": "READ",
      "description": "실행에 속하는 품목·공장의 가용 재고 조회. 공급 자격 조회는 별도 확장.",
      "input_schema": {
        "type": "object",
        "properties": {
          "part_id": {
            "type": "string",
            "minLength": 1
          },
          "plant_id": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "part_id",
          "plant_id"
        ],
        "additionalProperties": false
      },
      "output_fields": [
        "part_id",
        "plant_id",
        "available_quantity",
        "unit",
        "inventory_version"
      ]
    },
    {
      "name": "get_supplier",
      "effect": "READ",
      "description": "공급업체 활성 여부와 시험 견적 조회.",
      "input_schema": {
        "type": "object",
        "properties": {
          "supplier_id": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "supplier_id"
        ],
        "additionalProperties": false
      },
      "output_fields": [
        "supplier_id",
        "status",
        "unit_price_minor",
        "currency",
        "supplier_version"
      ]
    },
    {
      "name": "create_purchase_order",
      "effect": "WRITE",
      "description": "서버가 유효한 승인과 요청 내용을 검증한 후 발주 생성. 같은 요청의 재시도는 request_id와 내용을 유지.",
      "input_schema": {
        "type": "object",
        "properties": {
          "request": {
            "type": "object",
            "properties": {
              "request_id": {
                "type": "string",
                "minLength": 1
              },
              "request_version": {
                "type": "integer",
                "minimum": 1
              },
              "part_id": {
                "type": "string",
                "minLength": 1
              },
              "quantity": {
                "type": "integer",
                "minimum": 1
              },
              "unit_price_minor": {
                "type": "integer",
                "minimum": 0
              },
              "currency": {
                "const": "KRW"
              },
              "supplier_id": {
                "type": "string",
                "minLength": 1
              },
              "plant_id": {
                "type": "string",
                "minLength": 1
              },
              "purchasing_org_id": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "request_id",
              "request_version",
              "part_id",
              "quantity",
              "unit_price_minor",
              "currency",
              "supplier_id",
              "plant_id",
              "purchasing_org_id"
            ],
            "additionalProperties": false
          },
          "approval_id": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "request",
          "approval_id"
        ],
        "additionalProperties": false
      },
      "output_fields": [
        "request_id",
        "order_id",
        "status",
        "committed_version"
      ]
    },
    {
      "name": "get_order_by_request",
      "effect": "READ",
      "description": "해당 실행·요청의 발주를 배열로 모두 반환. 첫 발주만 반환해 중복을 숨기지 않는다.",
      "input_schema": {
        "type": "object",
        "properties": {
          "request_id": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "request_id"
        ],
        "additionalProperties": false
      },
      "output_fields": [
        "request_id",
        "orders"
      ]
    }
  ],
  "tool_errors": [
    "TOOL_TIMEOUT",
    "PERMISSION_DENIED",
    "VALIDATION_ERROR",
    "APPROVAL_REQUIRED",
    "APPROVAL_REJECTED",
    "APPROVAL_MISMATCH",
    "REQUEST_PAYLOAD_MISMATCH",
    "INTERNAL_ERROR"
  ],
  "ambiguous_timeout": "TOOL_TIMEOUT은 저장 여부를 알려주지 않는다. commit·fault 연결 근거는 Runner/Oracle 경로에만 저장.",
  "approval_transport": "승인은 변경 도구가 아니라 서버의 승인 API와 checkpoint 재개 경로로 전달한다.",
  "extension_tools_not_in_baseline": [
    "list_supplier_offers",
    "get_supplier_eligibility",
    "get_current_request"
  ]
}
