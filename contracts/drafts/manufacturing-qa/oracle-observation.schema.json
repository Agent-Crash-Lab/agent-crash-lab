{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Oracle observation envelope — review draft",
  "type": "object",
  "required": [
    "run_id",
    "request_id",
    "snapshot_complete",
    "pending_tool_calls",
    "snapshot_evidence_ids",
    "orders",
    "approvals",
    "commit_evidence_ids"
  ],
  "additionalProperties": false,
  "properties": {
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "request_id": {
      "type": "string",
      "minLength": 1
    },
    "snapshot_complete": {
      "type": "boolean"
    },
    "pending_tool_calls": {
      "type": "integer",
      "minimum": 0
    },
    "snapshot_evidence_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "commit_evidence_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "orders": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/order"
      }
    },
    "approvals": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/approval"
      }
    }
  },
  "description": "독립 관측 경로의 구매 row 개발 계약. 같은 run/요청·payload hash·승인 선후·생성 주체의 신뢰는 Oracle/서버가 추가 검사한다. 모델이 만든 authority_valid 플래그는 신뢰할 수 없다.",
  "$defs": {
    "payload": {
      "type": "object",
      "properties": {
        "request_id": {
          "type": "string",
          "minLength": 1
        },
        "request_version": {
          "type": "integer",
          "minimum": 1
        },
        "part_id": {
          "type": "string",
          "minLength": 1
        },
        "quantity": {
          "type": "integer",
          "minimum": 1
        },
        "unit_price_minor": {
          "type": "integer",
          "minimum": 0
        },
        "currency": {
          "const": "KRW"
        },
        "supplier_id": {
          "type": "string",
          "minLength": 1
        },
        "plant_id": {
          "type": "string",
          "minLength": 1
        },
        "purchasing_org_id": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "request_id",
        "request_version",
        "part_id",
        "quantity",
        "unit_price_minor",
        "currency",
        "supplier_id",
        "plant_id",
        "purchasing_org_id"
      ],
      "additionalProperties": false
    },
    "order": {
      "type": "object",
      "properties": {
        "order_id": {
          "type": "string",
          "minLength": 1
        },
        "run_id": {
          "type": "string",
          "minLength": 1
        },
        "request_id": {
          "type": "string",
          "minLength": 1
        },
        "approval_id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "payload": {
          "$ref": "#/$defs/payload"
        },
        "commit_sequence": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "order_id",
        "run_id",
        "request_id",
        "approval_id",
        "payload",
        "commit_sequence"
      ],
      "additionalProperties": false
    },
    "approval": {
      "type": "object",
      "properties": {
        "approval_id": {
          "type": "string",
          "minLength": 1
        },
        "run_id": {
          "type": "string",
          "minLength": 1
        },
        "request_id": {
          "type": "string",
          "minLength": 1
        },
        "request_version": {
          "type": "integer",
          "minimum": 1
        },
        "approver_id": {
          "type": "string",
          "minLength": 1
        },
        "decision": {
          "enum": [
            "APPROVED",
            "REJECTED"
          ]
        },
        "payload": {
          "$ref": "#/$defs/payload"
        },
        "payload_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "revoked": {
          "type": "boolean"
        },
        "decision_sequence": {
          "type": "integer",
          "minimum": 1
        },
        "authority_valid": {
          "type": "boolean"
        }
      },
      "required": [
        "approval_id",
        "run_id",
        "request_id",
        "request_version",
        "approver_id",
        "decision",
        "payload",
        "payload_hash",
        "revoked",
        "decision_sequence",
        "authority_valid"
      ],
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "snapshot_complete": {
            "const": true
          }
        }
      },
      "then": {
        "properties": {
          "pending_tool_calls": {
            "const": 0
          },
          "snapshot_evidence_ids": {
            "minItems": 1
          }
        }
      }
    }
  ]
}
