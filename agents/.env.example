# Local uvicorn execution; Docker Compose injects its own MCP_URL.
MCP_URL=http://localhost:8081/mcp
# Match the root .env.example / Docker Compose variable name.
LLM_API_KEY=
# Set before live model integration. Not needed for mock tests.
LLM_MODEL=

# Internal HTTP API credential. Generate locally; never commit the value.
INTERNAL_API_TOKEN=
# Optional; defaults to .agent-state/ in the current working directory.
# AGENT_STATE_DIR=.agent-state
