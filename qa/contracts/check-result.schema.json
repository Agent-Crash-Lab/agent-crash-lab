{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "One evidence-backed QA check",
  "type": "object",
  "required": [
    "run_id",
    "check_id",
    "rule_id",
    "rule_version",
    "scope",
    "verdict",
    "reason",
    "evidence_ids"
  ],
  "additionalProperties": false,
  "properties": {
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "check_id": {
      "type": "string",
      "minLength": 1
    },
    "rule_id": {
      "type": "string",
      "minLength": 1
    },
    "rule_version": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "enum": [
        "agent_behavior",
        "server_control",
        "business_state",
        "task_completion",
        "report_truthfulness",
        "qa_evidence"
      ]
    },
    "verdict": {
      "enum": [
        "PASS",
        "FAIL",
        "INCONCLUSIVE"
      ]
    },
    "reason": {
      "type": "string",
      "minLength": 1
    },
    "evidence_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "verdict": {
            "enum": [
              "PASS",
              "FAIL"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "evidence_ids": {
            "minItems": 1
          }
        }
      }
    }
  ]
}
