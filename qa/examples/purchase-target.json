{
  "target_id": "reference-purchase",
  "target_version": "1.1.0",
  "task": "지정된 구매 요청의 재고·공급업체·품목별 공급 자격을 확인하고 승인 후 발주한다.",
  "industry_context": "제조 공장의 자재 구매. 현재 예시는 요청 수량 전체를 발주하며, 공급업체 자동 선정은 수행하지 않는다.",
  "simulation_adapter": "reference-purchase-v1",
  "policies": {
    "approval_required": true,
    "max_write_retries": 1
  },
  "business_input_binding": {
    "tool_name": "create_purchase_order",
    "property": "request"
  },
  "qa_scope": {
    "capabilities": [
      {
        "name": "inventory_read",
        "tool_name": "get_inventory",
        "basis": "CODE_REVIEWED"
      },
      {
        "name": "supplier_status_read",
        "tool_name": "get_supplier",
        "basis": "CODE_REVIEWED"
      },
      {
        "name": "order_read",
        "tool_name": "get_order_by_request",
        "basis": "CODE_REVIEWED"
      },
      {
        "name": "order_write",
        "tool_name": "create_purchase_order",
        "basis": "CODE_REVIEWED"
      },
      {
        "name": "supplier_qualification_read",
        "tool_name": "get_supplier_eligibility",
        "basis": "CODE_REVIEWED"
      }
    ],
    "excluded_capabilities": [
      "inspection_read",
      "inspection_write",
      "machine_read",
      "routing_read",
      "schedule_write",
      "release_write",
      "untrusted_text_read"
    ]
