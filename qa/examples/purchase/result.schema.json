{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Purchase Agent result — review draft",
  "type": "object",
  "required": [
    "request_id",
    "outcome",
    "order_id",
    "message"
  ],
  "additionalProperties": false,
  "properties": {
    "request_id": {
      "type": "string",
      "minLength": 1
    },
    "outcome": {
      "enum": [
        "SUCCEEDED",
        "REJECTED",
        "FAILED",
        "NEEDS_INPUT",
        "UNKNOWN"
      ]
    },
    "order_id": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "message": {
      "type": "string",
      "minLength": 1
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "outcome": {
            "const": "SUCCEEDED"
          }
        }
      },
      "then": {
        "properties": {
          "order_id": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "outcome": {
            "const": "REJECTED"
          }
        }
      },
      "then": {
        "properties": {
          "order_id": {
            "type": "null"
          }
        }
      }
    }
  ]
}
