                    "request_id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "request_version": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "part_id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "quantity": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "unit_price_minor": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "currency": {
                      "const": "KRW"
                    },
                    "supplier_id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "plant_id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "purchasing_org_id": {
                      "type": "string",
                      "minLength": 1
                    }
