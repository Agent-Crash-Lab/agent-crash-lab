                  "required": [
                    "request_id",
                    "request_version",
                    "part_id",
                    "quantity",
                    "unit_price_minor",
                    "currency",
                    "supplier_id",
                    "plant_id",
                    "purchasing_org_id"
                  ],
                  "additionalProperties": false
                },
                "approval_id": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "request",
                "approval_id"
              ],
              "additionalProperties": false
            }
          },
          {
            "name": "get_order_by_request",
            "effect": "READ",
